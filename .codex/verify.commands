# wave-7-user-owned
# Canonical local verification. This does not deploy or prove Vercel readiness.
pnpm install --frozen-lockfile
pnpm test
pnpm typecheck
pnpm lint
pnpm --filter @aiworkflow/portal build
# Start the built portal separately on 127.0.0.1:3100 before this check.
# Leave PORTAL_AUTH_COOKIE unset for the non-secret local lane.
pnpm smoke:portal http://127.0.0.1:3100
